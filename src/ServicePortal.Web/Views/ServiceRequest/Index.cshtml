@model ServicePortal.Application.DTOs.PagedResult<ServicePortal.Application.DTOs.ServiceRequestListItemDto>
@{
    ViewData["Title"] = "Service Requests";
    var filter = (ServicePortal.Application.DTOs.RequestFilterDto)ViewBag.Filter;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h2 class="fw-bold mb-1 text-dark" style="letter-spacing: -0.02em;">Service Requests Directory</h2>
        <p class="text-muted small mb-0">Browse, filter, and track service requests according to your authorized department scope</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv"
           asp-route-searchTerm="@filter.SearchTerm"
           asp-route-status="@filter.Status"
           asp-route-categoryId="@filter.CategoryId"
           asp-route-priority="@filter.Priority"
           asp-route-teamId="@filter.TeamId"
           asp-route-slaState="@filter.SlaState"
           class="btn btn-outline-success">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </a>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Submit Request
        </a>
    </div>
</div>

<!-- Filter Toolbar -->
<div class="card portal-card border-0 mb-4 shadow-sm">
    <div class="card-body p-4">
        <form method="get" asp-action="Index">
            <div class="row g-3">
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">Search Keywords</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="SearchTerm" value="@filter.SearchTerm" class="form-control border-start-0 ps-0" placeholder="Ref, title, requester..." />
                    </div>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-bold text-muted mb-1">Status</label>
                    <select name="Status" class="form-select" asp-items="Html.GetEnumSelectList<RequestStatus>()">
                        <option value="">All Statuses</option>
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-bold text-muted mb-1">Priority</label>
                    <select name="Priority" class="form-select" asp-items="Html.GetEnumSelectList<RequestPriority>()">
                        <option value="">All Priorities</option>
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-bold text-muted mb-1">Category</label>
                    <select name="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                        <option value="">All Categories</option>
                    </select>
                </div>

                <div class="col-6 col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">SLA Health State</label>
                    <select name="SlaState" class="form-select">
                        <option value="">All SLA States</option>
                        <option value="breached" selected="@(filter.SlaState == "breached")">Breached Only</option>
                        <option value="approaching" selected="@(filter.SlaState == "approaching")">Approaching (&le; 2h)</option>
                    </select>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-muted fw-semibold">Sort by:</span>
                    <select name="SortBy" class="form-select form-select-sm w-auto d-inline">
                        <option value="CreatedAt" selected="@(filter.SortBy == "CreatedAt")">Date Created</option>
                        <option value="Reference" selected="@(filter.SortBy == "Reference")">Reference #</option>
                        <option value="Priority" selected="@(filter.SortBy == "Priority")">Priority</option>
                        <option value="Status" selected="@(filter.SortBy == "Status")">Status</option>
                        <option value="SlaDue" selected="@(filter.SortBy == "SlaDue")">SLA Deadline</option>
                    </select>
                    <select name="SortDescending" class="form-select form-select-sm w-auto d-inline">
                        <option value="true" selected="@(filter.SortDescending)">Descending</option>
                        <option value="false" selected="@(!filter.SortDescending)">Ascending</option>
                    </select>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset Filters</a>
                    <button type="submit" class="btn btn-sm btn-primary px-3 shadow-sm">Apply Filters</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Requests Data Table -->
<div class="card portal-card border-0 mb-4 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-portal table-hover mb-0">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Team</th>
                        <th>Requester</th>
                        <th>Assignee</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>SLA Deadline</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="11" class="text-center py-5 text-muted">
                                <div class="empty-state py-2">
                                    <div class="empty-state-icon">
                                        <i class="bi bi-funnel"></i>
                                    </div>
                                    <h5 class="empty-state-title">No Requests Found</h5>
                                    <p class="empty-state-desc mb-0">No service requests match the current search filters or authorized role scope.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr class="@(item.IsSlaBreached ? "bg-danger-subtle bg-opacity-25" : item.SlaHealth == SlaHealthStatus.Approaching ? "bg-warning-subtle bg-opacity-25" : "")">
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-decoration-none text-primary">
                                    @item.ReferenceNumber
                                </a>
                            </td>
                            <td>
                                <div class="fw-medium text-dark text-truncate" style="max-width: 240px;" title="@item.Title">
                                    @item.Title
                                </div>
                            </td>
                            <td><span class="badge bg-light text-secondary border">@item.CategoryName</span></td>
                            <td><span class="small text-dark fw-semibold">@item.SupportTeamName</span></td>
                            <td><span class="small text-secondary">@item.RequesterName</span></td>
                            <td>
                                @if (string.IsNullOrEmpty(item.AssigneeName))
                                {
                                    <span class="text-muted small fst-italic">Unassigned</span>
                                }
                                else
                                {
                                    <span class="small text-dark"><i class="bi bi-person-fill text-muted me-1"></i>@item.AssigneeName</span>
                                }
                            </td>
                            <td>
                                @if (item.Priority == RequestPriority.Critical)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Critical</span>
                                }
                                else if (item.Priority == RequestPriority.High)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">High</span>
                                }
                                else if (item.Priority == RequestPriority.Medium)
                                {
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">Medium</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">Low</span>
                                }
                            </td>
                            <td>
                                <span class="badge-status badge-status-@item.Status.ToString().ToLower()">
                                    @item.Status
                                </span>
                            </td>
                            <td>
                                @if (item.SlaHealth == SlaHealthStatus.Breached)
                                {
                                    <span class="badge-sla badge-sla-breached"><i class="bi bi-exclamation-triangle-fill"></i> Breached</span>
                                }
                                else if (item.SlaHealth == SlaHealthStatus.Approaching)
                                {
                                    <span class="badge-sla badge-sla-approaching"><i class="bi bi-clock-history"></i> Due Soon</span>
                                }
                                else if (item.Status == RequestStatus.Resolved || item.Status == RequestStatus.Closed)
                                {
                                    <span class="badge bg-light text-muted border">Completed</span>
                                }
                                else
                                {
                                    <span class="badge-sla badge-sla-healthy"><i class="bi bi-check2"></i> @item.ResolutionDueAt.ToString("MMM dd, HH:mm")</span>
                                }
                            </td>
                            <td class="small text-muted">@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                    View <i class="bi bi-arrow-right-short"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination Footer -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3 px-3">
            <div class="small text-muted">
                Showing @((Model.PageNumber - 1) * Model.PageSize + 1) to @(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount)) of @Model.TotalCount requests
            </div>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-pageNumber="@(Model.PageNumber - 1)"
                       asp-route-searchTerm="@filter.SearchTerm"
                       asp-route-status="@filter.Status"
                       asp-route-priority="@filter.Priority"
                       asp-route-categoryId="@filter.CategoryId"
                       asp-route-slaState="@filter.SlaState"
                       asp-route-sortBy="@filter.SortBy"
                       asp-route-sortDescending="@filter.SortDescending">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-pageNumber="@p"
                           asp-route-searchTerm="@filter.SearchTerm"
                           asp-route-status="@filter.Status"
                           asp-route-priority="@filter.Priority"
                           asp-route-categoryId="@filter.CategoryId"
                           asp-route-slaState="@filter.SlaState"
                           asp-route-sortBy="@filter.SortBy"
                           asp-route-sortDescending="@filter.SortDescending">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-pageNumber="@(Model.PageNumber + 1)"
                       asp-route-searchTerm="@filter.SearchTerm"
                       asp-route-status="@filter.Status"
                       asp-route-priority="@filter.Priority"
                       asp-route-categoryId="@filter.CategoryId"
                       asp-route-slaState="@filter.SlaState"
                       asp-route-sortBy="@filter.SortBy"
                       asp-route-sortDescending="@filter.SortDescending">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
