@using ServicePortal.Domain.Enums
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Service Request Portal (SSRMP)</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentEmail = User.Identity?.Name ?? "";
        string currentLabel = "Select Persona";
        string currentRoleBadge = "Demo Switcher";
        string currentIcon = "bi-person-circle";

        if (currentEmail == "admin@contoso.com") {
            currentLabel = "Administrator";
            currentRoleBadge = "Admin";
            currentIcon = "bi-shield-shaded text-danger";
        }
        else if (currentEmail == "lead.it@contoso.com") {
            currentLabel = "IT Team Lead";
            currentRoleBadge = "Team Lead";
            currentIcon = "bi-laptop text-primary";
        }
        else if (currentEmail == "lead.hr@contoso.com") {
            currentLabel = "HR Team Lead";
            currentRoleBadge = "Team Lead";
            currentIcon = "bi-person-badge text-warning";
        }
        else if (currentEmail == "agent.john@contoso.com") {
            currentLabel = "Agent John (IT)";
            currentRoleBadge = "Support Agent";
            currentIcon = "bi-headset text-info";
        }
        else if (currentEmail == "agent.sarah@contoso.com") {
            currentLabel = "Agent Sarah (Facilities)";
            currentRoleBadge = "Support Agent";
            currentIcon = "bi-tools text-info";
        }
        else if (currentEmail == "requester1@contoso.com") {
            currentLabel = "Alice (Verified Requester)";
            currentRoleBadge = "Requester";
            currentIcon = "bi-person-fill text-success";
        }
        else if (currentEmail == "unverified@contoso.com") {
            currentLabel = "Bob (Unverified Requester)";
            currentRoleBadge = "Unverified";
            currentIcon = "bi-shield-exclamation text-warning";
        }
        else if (!string.IsNullOrEmpty(currentEmail)) {
            currentLabel = currentEmail;
            currentRoleBadge = "User";
            currentIcon = "bi-person-check text-primary";
        }
    }
    <!-- Interactive Demo Switcher Bar for Reviewers & Evaluators -->
    <div class="demo-bar d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <span class="text-light opacity-75 small fw-semibold d-none d-sm-inline">
                <i class="bi bi-people-fill text-info me-1"></i> Switch Persona:
            </span>
            <div class="dropdown">
                <button class="btn btn-sm btn-persona-dropdown dropdown-toggle d-flex align-items-center gap-2" type="button" id="personaSelectDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi @currentIcon"></i>
                    <span class="fw-bold">@currentLabel</span>
                    <span class="badge bg-white bg-opacity-25 text-white ms-1 small">@currentRoleBadge</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark shadow-lg border-0 py-2 persona-menu" aria-labelledby="personaSelectDropdown">
                    <li class="dropdown-header text-uppercase text-light opacity-50 small fw-bold px-3 py-1">
                        Leadership & Administration
                    </li>
                    <li>
                        <form asp-controller="Account" asp-action="QuickLogin" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="email" value="admin@contoso.com" />
                            <button type="submit" class="dropdown-item d-flex align-items-center justify-content-between py-2 px-3 @(currentEmail == "admin@contoso.com" ? "active" : "")">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="persona-avatar bg-danger text-white"><i class="bi bi-shield-shaded"></i></span>
                                    <div>
                                        <div class="fw-semibold small">Administrator</div>
                                        <div class="text-white-50" style="font-size: 0.72rem;">admin@contoso.com &bull; Global Setup & Audit</div>
                                    </div>
                                </div>
                                @if (currentEmail == "admin@contoso.com") { <i class="bi bi-check-circle-fill text-success"></i> }
                            </button>
                        </form>
                    </li>
                    <li>
                        <form asp-controller="Account" asp-action="QuickLogin" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="email" value="lead.it@contoso.com" />
                            <button type="submit" class="dropdown-item d-flex align-items-center justify-content-between py-2 px-3 @(currentEmail == "lead.it@contoso.com" ? "active" : "")">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="persona-avatar bg-primary text-white"><i class="bi bi-laptop"></i></span>
                                    <div>
                                        <div class="fw-semibold small">IT Team Lead</div>
                                        <div class="text-white-50" style="font-size: 0.72rem;">lead.it@contoso.com &bull; IT Triage & Workloads</div>
                                    </div>
                                </div>
                                @if (currentEmail == "lead.it@contoso.com") { <i class="bi bi-check-circle-fill text-success"></i> }
                            </button>
                        </form>
                    </li>
                    <li>
                        <form asp-controller="Account" asp-action="QuickLogin" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="email" value="lead.hr@contoso.com" />
                            <button type="submit" class="dropdown-item d-flex align-items-center justify-content-between py-2 px-3 @(currentEmail == "lead.hr@contoso.com" ? "active" : "")">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="persona-avatar bg-warning text-dark"><i class="bi bi-person-badge"></i></span>
                                    <div>
                                        <div class="fw-semibold small">HR Team Lead</div>
                                        <div class="text-white-50" style="font-size: 0.72rem;">lead.hr@contoso.com &bull; HR & Payroll Workflows</div>
                                    </div>
                                </div>
                                @if (currentEmail == "lead.hr@contoso.com") { <i class="bi bi-check-circle-fill text-success"></i> }
                            </button>
                        </form>
                    </li>

                    <li><hr class="dropdown-divider my-1 opacity-25"></li>
                    <li class="dropdown-header text-uppercase text-light opacity-50 small fw-bold px-3 py-1">
                        Support Agents
                    </li>
                    <li>
                        <form asp-controller="Account" asp-action="QuickLogin" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="email" value="agent.john@contoso.com" />
                            <button type="submit" class="dropdown-item d-flex align-items-center justify-content-between py-2 px-3 @(currentEmail == "agent.john@contoso.com" ? "active" : "")">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="persona-avatar bg-info text-dark"><i class="bi bi-headset"></i></span>
                                    <div>
                                        <div class="fw-semibold small">Agent John (IT)</div>
                                        <div class="text-white-50" style="font-size: 0.72rem;">agent.john@contoso.com &bull; Technical Tickets</div>
                                    </div>
                                </div>
                                @if (currentEmail == "agent.john@contoso.com") { <i class="bi bi-check-circle-fill text-success"></i> }
                            </button>
                        </form>
                    </li>
                    <li>
                        <form asp-controller="Account" asp-action="QuickLogin" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="email" value="agent.sarah@contoso.com" />
                            <button type="submit" class="dropdown-item d-flex align-items-center justify-content-between py-2 px-3 @(currentEmail == "agent.sarah@contoso.com" ? "active" : "")">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="persona-avatar bg-info text-dark"><i class="bi bi-tools"></i></span>
                                    <div>
                                        <div class="fw-semibold small">Agent Sarah (Facilities)</div>
                                        <div class="text-white-50" style="font-size: 0.72rem;">agent.sarah@contoso.com &bull; Facilities Maintenance</div>
                                    </div>
                                </div>
                                @if (currentEmail == "agent.sarah@contoso.com") { <i class="bi bi-check-circle-fill text-success"></i> }
                            </button>
                        </form>
                    </li>

                    <li><hr class="dropdown-divider my-1 opacity-25"></li>
                    <li class="dropdown-header text-uppercase text-light opacity-50 small fw-bold px-3 py-1">
                        Requesters / Employees
                    </li>
                    <li>
                        <form asp-controller="Account" asp-action="QuickLogin" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="email" value="requester1@contoso.com" />
                            <button type="submit" class="dropdown-item d-flex align-items-center justify-content-between py-2 px-3 @(currentEmail == "requester1@contoso.com" ? "active" : "")">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="persona-avatar bg-success text-white"><i class="bi bi-person-fill"></i></span>
                                    <div>
                                        <div class="fw-semibold small">Alice (Verified Requester)</div>
                                        <div class="text-white-50" style="font-size: 0.72rem;">requester1@contoso.com &bull; Standard Support Tickets</div>
                                    </div>
                                </div>
                                @if (currentEmail == "requester1@contoso.com") { <i class="bi bi-check-circle-fill text-success"></i> }
                            </button>
                        </form>
                    </li>
                    <li>
                        <form asp-controller="Account" asp-action="QuickLogin" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="email" value="unverified@contoso.com" />
                            <button type="submit" class="dropdown-item d-flex align-items-center justify-content-between py-2 px-3 @(currentEmail == "unverified@contoso.com" ? "active" : "")">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="persona-avatar bg-warning text-dark"><i class="bi bi-shield-exclamation"></i></span>
                                    <div>
                                        <div class="fw-semibold small">Bob (Unverified Requester)</div>
                                        <div class="text-white-50" style="font-size: 0.72rem;">unverified@contoso.com &bull; Test AC-01 Verification Gate</div>
                                    </div>
                                </div>
                                @if (currentEmail == "unverified@contoso.com") { <i class="bi bi-check-circle-fill text-success"></i> }
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
        <div class="text-light opacity-75 small d-none d-md-block">
            <i class="bi bi-clock-history text-info me-1"></i> SLA Hours: Mon-Fri 09:00 - 18:00
        </div>
    </div>

    <!-- Main Navigation Bar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-contoso">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand text-decoration-none d-flex align-items-center gap-2" asp-controller="Dashboard" asp-action="Index">
                    <span class="navbar-brand-badge">
                        <i class="bi bi-shield-check"></i> SSRMP
                    </span>
                    <span class="fw-bold text-dark fs-5">Contoso Support Services</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1 ms-lg-3">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2-fill text-primary"></i> Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="ServiceRequest" asp-action="Index"><i class="bi bi-card-checklist text-indigo"></i> Service Requests</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="ServiceRequest" asp-action="Create"><i class="bi bi-plus-circle-fill text-success"></i> Submit Request</a>
                            </li>
                            @if (User.IsInRole(AppRoles.Administrator))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-gear-fill text-secondary"></i> Administration
                                    </a>
                                    <ul class="dropdown-menu border-0 shadow-lg">
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users"><i class="bi bi-people me-2"></i> User Management</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Teams"><i class="bi bi-diagram-3 me-2"></i> Support Teams</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Categories"><i class="bi bi-tags me-2"></i> Request Categories</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="SlaPolicies"><i class="bi bi-stopwatch me-2"></i> SLA Policies</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="AuditLogs"><i class="bi bi-journal-text me-2"></i> Audit Logs</a></li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center gap-3">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link position-relative p-2" asp-controller="Notifications" asp-action="Index" title="Notifications">
                                    <i class="bi bi-bell-fill fs-5 text-secondary"></i>
                                    <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none shadow-sm">
                                        0
                                    </span>
                                </a>
                            </li>
                            <li class="nav-item d-flex align-items-center gap-2">
                                <div class="user-profile-pill">
                                    <div class="user-avatar-circle">
                                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                    <div class="text-start pe-1">
                                        <div class="fw-bold small text-dark lh-sm">@User.Identity?.Name</div>
                                        <div class="text-muted lh-1" style="font-size: 0.72rem;">
                                            @(User.IsInRole(AppRoles.Administrator) ? "Administrator" :
                                              User.IsInRole(AppRoles.TeamLead) ? "Team Lead" :
                                              User.IsInRole(AppRoles.SupportAgent) ? "Support Agent" : "Requester")
                                        </div>
                                    </div>
                                </div>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Sign Out" style="border-radius: 8px;"><i class="bi bi-box-arrow-right"></i></button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm" asp-controller="Account" asp-action="Login">Sign In</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Container -->
    <main role="main" class="container-fluid px-lg-4 py-4 flex-grow-1">
        <!-- Toast / Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show portal-card border-0 shadow-sm mb-3" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show portal-card border-0 shadow-sm mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="portal-footer">
        <div class="container-fluid px-lg-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                &copy; @DateTime.UtcNow.Year Contoso Support Services &bull; Smart Service Request Management Portal
            </div>
            <div class="small text-muted d-flex align-items-center gap-3">
                <span><i class="bi bi-shield-lock"></i> Protected & Parameterized EF Core</span>
                <span><i class="bi bi-calendar2-week"></i> 09:00 - 18:00 Mon-Fri SLA</span>
                <span>Correlation ID: <code>@(Context.Items[ServicePortal.Web.Middleware.CorrelationIdMiddleware.CorrelationHeaderName] ?? "N/A")</code></span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Check in-app notification count
        function updateNotificationBadge() {
            fetch('/Notifications/GetUnreadCount')
                .then(r => r.json())
                .then(data => {
                    const badge = document.getElementById('notificationBadge');
                    if (badge && data && data.unreadCount > 0) {
                        badge.textContent = data.unreadCount;
                        badge.classList.remove('d-none');
                    } else if (badge) {
                        badge.classList.add('d-none');
                    }
                }).catch(() => {});
        }
        document.addEventListener('DOMContentLoaded', updateNotificationBadge);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
