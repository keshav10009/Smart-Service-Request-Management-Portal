@using ServicePortal.Domain.Enums
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Service Request Portal (SSRMP)</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Interactive Demo Switcher Bar for Reviewers & Evaluators -->
    <div class="demo-bar d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary text-white"><i class="bi bi-person-badge"></i> Quick Persona Switcher:</span>
            <form asp-controller="Account" asp-action="QuickLogin" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" value="admin@contoso.com" />
                <button type="submit" class="btn btn-sm btn-outline-light btn-demo">Admin</button>
            </form>
            <form asp-controller="Account" asp-action="QuickLogin" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" value="lead.it@contoso.com" />
                <button type="submit" class="btn btn-sm btn-outline-light btn-demo">IT Lead</button>
            </form>
            <form asp-controller="Account" asp-action="QuickLogin" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" value="lead.hr@contoso.com" />
                <button type="submit" class="btn btn-sm btn-outline-light btn-demo">HR Lead</button>
            </form>
            <form asp-controller="Account" asp-action="QuickLogin" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" value="agent.john@contoso.com" />
                <button type="submit" class="btn btn-sm btn-outline-light btn-demo">Agent John (IT)</button>
            </form>
            <form asp-controller="Account" asp-action="QuickLogin" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" value="agent.sarah@contoso.com" />
                <button type="submit" class="btn btn-sm btn-outline-light btn-demo">Agent Sarah (Fac)</button>
            </form>
            <form asp-controller="Account" asp-action="QuickLogin" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" value="requester1@contoso.com" />
                <button type="submit" class="btn btn-sm btn-outline-light btn-demo">Requester (Alice)</button>
            </form>
            <form asp-controller="Account" asp-action="QuickLogin" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" value="unverified@contoso.com" />
                <button type="submit" class="btn btn-sm btn-outline-warning btn-demo">Requester (Unverified)</button>
            </form>
        </div>
        <div class="text-light opacity-75 small d-none d-md-block">
            <i class="bi bi-clock-history"></i> SLA Business Hours: Mon-Fri 09:00 - 18:00
        </div>
    </div>

    <!-- Main Navigation Bar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-contoso">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand text-decoration-none d-flex align-items-center gap-2" asp-controller="Dashboard" asp-action="Index">
                    <span class="navbar-brand-badge">
                        <i class="bi bi-shield-check"></i> SSRMP
                    </span>
                    <span class="fw-bold text-dark">Contoso Support Services</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i> Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="ServiceRequest" asp-action="Index"><i class="bi bi-card-checklist"></i> Service Requests</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="ServiceRequest" asp-action="Create"><i class="bi bi-plus-circle"></i> Submit Request</a>
                            </li>
                            @if (User.IsInRole(AppRoles.Administrator))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-gear"></i> Administration
                                    </a>
                                    <ul class="dropdown-menu border-0 shadow-sm">
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users"><i class="bi bi-people"></i> User Management</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Teams"><i class="bi bi-diagram-3"></i> Support Teams</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Categories"><i class="bi bi-tags"></i> Request Categories</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="SlaPolicies"><i class="bi bi-stopwatch"></i> SLA Policies</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="AuditLogs"><i class="bi bi-journal-text"></i> Audit Logs</a></li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link position-relative px-2" asp-controller="Notifications" asp-action="Index" title="Notifications">
                                    <i class="bi bi-bell fs-5"></i>
                                    <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">
                                        0
                                    </span>
                                </a>
                            </li>
                            <li class="nav-item border-start ps-2 d-flex align-items-center gap-2">
                                <div class="text-end">
                                    <div class="fw-semibold small text-dark">@User.Identity?.Name</div>
                                    <div class="text-muted" style="font-size: 0.72rem;">
                                        @(User.IsInRole(AppRoles.Administrator) ? "Administrator" :
                                          User.IsInRole(AppRoles.TeamLead) ? "Team Lead" :
                                          User.IsInRole(AppRoles.SupportAgent) ? "Support Agent" : "Requester")
                                    </div>
                                </div>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Sign Out"><i class="bi bi-box-arrow-right"></i></button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm" asp-controller="Account" asp-action="Login">Sign In</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Container -->
    <main role="main" class="container-fluid px-lg-4 py-4 flex-grow-1">
        <!-- Toast / Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show portal-card border-0 shadow-sm mb-3" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show portal-card border-0 shadow-sm mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="portal-footer">
        <div class="container-fluid px-lg-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                &copy; @DateTime.UtcNow.Year Contoso Support Services &bull; Smart Service Request Management Portal
            </div>
            <div class="small text-muted d-flex align-items-center gap-3">
                <span><i class="bi bi-shield-lock"></i> Protected & Parameterized EF Core</span>
                <span><i class="bi bi-calendar2-week"></i> 09:00 - 18:00 Mon-Fri SLA</span>
                <span>Correlation ID: <code>@(Context.Items[ServicePortal.Web.Middleware.CorrelationIdMiddleware.CorrelationHeaderName] ?? "N/A")</code></span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Check in-app notification count
        function updateNotificationBadge() {
            fetch('/Notifications/GetUnreadCount')
                .then(r => r.json())
                .then(data => {
                    const badge = document.getElementById('notificationBadge');
                    if (badge && data && data.unreadCount > 0) {
                        badge.textContent = data.unreadCount;
                        badge.classList.remove('d-none');
                    } else if (badge) {
                        badge.classList.add('d-none');
                    }
                }).catch(() => {});
        }
        document.addEventListener('DOMContentLoaded', updateNotificationBadge);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
