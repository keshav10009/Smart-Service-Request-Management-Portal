@model ServicePortal.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = "System Error";
}

<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-6 text-center">
        <div class="card portal-card border-0 p-5 shadow-sm">
            <div class="text-danger mb-3">
                <i class="bi bi-exclamation-triangle-fill display-1"></i>
            </div>
            <h2 class="fw-bold">An Unexpected Error Occurred</h2>
            <p class="text-muted mt-2">
                An internal issue prevented this request from completing. The incident has been recorded in the central structured audit logs (AC-11).
            </p>

            <div class="bg-light p-3 rounded-3 text-start mt-3 small border">
                @if (Model.ShowCorrelationId)
                {
                    <div class="mb-1">
                        <strong>Correlation Identifier (AC-11):</strong>
                        <code class="text-primary fw-bold">@Model.CorrelationId</code>
                    </div>
                }
                @if (Model.ShowRequestId)
                {
                    <div>
                        <strong>Trace Identifier:</strong>
                        <code>@Model.RequestId</code>
                    </div>
                }
                <div class="text-muted mt-2" style="font-size: 0.78rem;">
                    <i class="bi bi-shield-check"></i> Sensitive database connection details and stack traces have been concealed from the client for security compliance.
                </div>
            </div>

            <div class="mt-4 d-flex justify-content-center gap-2">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4">
                    <i class="bi bi-arrow-left"></i> Return to Dashboard
                </a>
                <a asp-controller="ServiceRequest" asp-action="Index" class="btn btn-outline-secondary px-4">
                    View Requests
                </a>
            </div>
        </div>
    </div>
</div>
