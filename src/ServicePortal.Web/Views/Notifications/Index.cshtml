@model List<ServicePortal.Domain.Entities.Notification>
@{
    ViewData["Title"] = "In-App Notifications";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-bell-fill text-primary"></i> Notifications</h2>
        <p class="text-muted small mb-0">System alerts, assignment notices, SLA breaches, and ticket updates</p>
    </div>
    @if (Model.Any(n => !n.IsRead))
    {
        <form asp-action="MarkAllAsRead" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-check-all"></i> Mark All as Read
            </button>
        </form>
    }
</div>

<div class="card portal-card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="list-group list-group-flush">
            @if (Model.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-bell-slash fs-2 d-block mb-2"></i>
                    You have no notifications at this time.
                </div>
            }
            @foreach (var n in Model)
            {
                <div class="list-group-item p-3 @(!n.IsRead ? "bg-light border-start border-primary border-4" : "")">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <div class="d-flex align-items-center gap-2">
                            @if (!n.IsRead)
                            {
                                <span class="badge bg-primary rounded-pill" style="font-size: 0.65rem;">NEW</span>
                            }
                            <span class="fw-bold text-dark">@n.Title</span>
                        </div>
                        <span class="small text-muted">@n.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                    <p class="text-muted small mb-2 text-break">@n.Message</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            @if (n.RelatedRequestId.HasValue)
                            {
                                <a asp-controller="ServiceRequest" asp-action="Details" asp-route-id="@n.RelatedRequestId.Value" class="btn btn-sm btn-outline-secondary py-0">
                                    View Ticket #@n.RelatedRequestId
                                </a>
                            }
                        </div>
                        @if (!n.IsRead)
                        {
                            <form asp-action="MarkAsRead" asp-route-id="@n.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-link btn-sm text-decoration-none p-0 text-muted">
                                    Mark as read
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
