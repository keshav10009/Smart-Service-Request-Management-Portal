@{
    ViewData["Title"] = "Account Inactive";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="card portal-card border-0 p-5 shadow-sm">
            <div class="text-warning mb-3">
                <i class="bi bi-person-x-fill display-1"></i>
            </div>
            <h2 class="fw-bold">Account Deactivated</h2>
            <p class="text-muted mt-2">
                Your portal account has been deactivated by a system administrator. Even if your login credentials are correct, access is restricted according to organizational security policy (Section 6.1).
            </p>
            <div class="mt-4">
                <a asp-action="Login" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-box-arrow-in-left"></i> Return to Sign In
                </a>
            </div>
        </div>
    </div>
</div>
