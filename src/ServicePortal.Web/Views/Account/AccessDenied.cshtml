@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="card portal-card border-0 p-5 shadow-sm">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-lock-fill display-1"></i>
            </div>
            <h2 class="fw-bold">403 - Access Denied</h2>
            <p class="text-muted mt-2">
                You do not possess the required role permissions to access this requested administrative resource or service request.
            </p>
            <div class="mt-4">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4">
                    <i class="bi bi-arrow-left"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
