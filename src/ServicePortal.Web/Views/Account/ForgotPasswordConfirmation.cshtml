@{
    ViewData["Title"] = "Password Reset Sent";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="card portal-card border-0 p-5 shadow-sm">
            <div class="text-success mb-3">
                <i class="bi bi-shield-check display-1"></i>
            </div>
            <h3 class="fw-bold">Password Reset Simulated</h3>
            <p class="text-muted mt-2">
                If the email address exists in Contoso Support Services, password reset instructions and security tokens have been dispatched.
            </p>
            @if (ViewBag.ResetToken != null)
            {
                <div class="alert alert-info small text-start mt-3">
                    <strong>Demo Note:</strong> Simulated reset token generated: <code>@ViewBag.ResetToken</code>
                </div>
            }
            <div class="mt-4">
                <a asp-action="Login" class="btn btn-outline-primary px-4">Return to Sign In</a>
            </div>
        </div>
    </div>
</div>
