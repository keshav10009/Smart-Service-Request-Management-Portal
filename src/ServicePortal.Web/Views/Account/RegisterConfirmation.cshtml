@model string
@{
    ViewData["Title"] = "Registration Received";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="card portal-card border-0 p-5 shadow-sm">
            <div class="text-primary mb-3">
                <i class="bi bi-envelope-check-fill display-1"></i>
            </div>
            <h2 class="fw-bold">Verification Email Sent</h2>
            <p class="text-muted mt-2">
                We have registered your account for <strong>@Model</strong>.
                Before you can submit service requests (AC-01 requirement), please confirm your email address.
            </p>
            <div class="mt-4 d-flex justify-content-center gap-2">
                <a asp-action="Login" class="btn btn-primary px-4">Sign In</a>
            </div>
        </div>
    </div>
</div>
