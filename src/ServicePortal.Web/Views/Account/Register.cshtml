@model ServicePortal.Web.Controllers.RegisterViewModel
@{
    ViewData["Title"] = "Register Account";
}

<div class="row justify-content-center align-items-center py-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card portal-card border-0 shadow">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <span class="navbar-brand-badge fs-4 mb-2">
                        <i class="bi bi-person-plus"></i> Contoso SSRMP
                    </span>
                    <h3 class="fw-bold mt-2">Create Requester Account</h3>
                    <p class="text-muted small">Register to submit and track service requests</p>
                </div>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DisplayName" class="form-label fw-semibold small">Full Name</label>
                            <input asp-for="DisplayName" class="form-control" placeholder="Jane Doe" required />
                            <span asp-validation-for="DisplayName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Department" class="form-label fw-semibold small">Department</label>
                            <input asp-for="Department" class="form-control" placeholder="Finance, Sales, Marketing..." />
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold small">Company Email Address</label>
                        <input asp-for="Email" class="form-control" placeholder="jane.doe@contoso.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label fw-semibold small">Password</label>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" required />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold small">Confirm Password</label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" required />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Email Verification Simulation Toggle for AC-01 Demo Testing -->
                    <div class="bg-light p-3 rounded-3 mb-4 small border">
                        <div class="form-check form-switch">
                            <input asp-for="SimulateEmailVerification" class="form-check-input" type="checkbox" id="simEmailCheck" checked>
                            <label class="form-check-label fw-semibold text-dark" for="simEmailCheck">
                                Auto-verify email upon registration (Simulated)
                            </label>
                        </div>
                        <div class="text-muted mt-1" style="font-size: 0.78rem;">
                            Uncheck this box to test the <strong>AC-01 requirement</strong>: unverified requesters are blocked from submitting service requests until email confirmation.
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Complete Registration</button>
                </form>

                <div class="text-center mt-4 small text-muted">
                    Already registered? <a asp-action="Login" class="text-decoration-none fw-semibold">Sign in here</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
