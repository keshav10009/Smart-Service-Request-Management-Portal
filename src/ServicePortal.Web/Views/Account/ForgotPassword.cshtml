@model ServicePortal.Web.Controllers.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center align-items-center py-5">
    <div class="col-12 col-md-6 col-lg-5">
        <div class="card portal-card border-0 p-4 shadow-sm">
            <h3 class="fw-bold mb-2">Reset Password</h3>
            <p class="text-muted small">Enter your email address to receive password reset instructions.</p>

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold">Email Address</label>
                    <input asp-for="Email" class="form-control" placeholder="name@contoso.com" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Send Reset Link</button>
            </form>
            <div class="text-center mt-3">
                <a asp-action="Login" class="small text-decoration-none">Back to Sign In</a>
            </div>
        </div>
    </div>
</div>
