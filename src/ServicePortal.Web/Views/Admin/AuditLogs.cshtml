@model List<ServicePortal.Domain.Entities.AuditLog>
@{
    ViewData["Title"] = "System Audit Trail";
    var pageNum = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-journal-text text-primary"></i> System Audit Trail & Compliance</h2>
        <p class="text-muted small mb-0">Immutable tracking of user activities, state transitions, SLA breaches, and correlation identifiers (AC-11)</p>
    </div>
    <a asp-controller="Dashboard" asp-action="Admin" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Admin Dashboard
    </a>
</div>

<!-- Search Bar -->
<div class="card portal-card border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="AuditLogs" class="row g-2">
            <div class="col-md-5">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search actor, action, entity, details..." />
            </div>
            <div class="col-md-5">
                <input type="text" name="correlationId" value="@ViewBag.CorrelationId" class="form-control form-control-sm" placeholder="Filter by Correlation ID..." />
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm w-100">Filter</button>
                <a asp-action="AuditLogs" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card portal-card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-portal table-hover mb-0">
                <thead>
                    <tr>
                        <th>Timestamp (UTC)</th>
                        <th>Actor</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Identifier</th>
                        <th>Change Summary</th>
                        <th>Correlation ID</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No audit logs matching search criteria.</td>
                        </tr>
                    }
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="small text-muted">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="fw-semibold">@log.ActorName</td>
                            <td><span class="badge bg-light text-dark border">@log.Action</span></td>
                            <td>@log.EntityName</td>
                            <td class="fw-bold">@log.EntityId</td>
                            <td class="small text-break" style="max-width: 320px;">@log.Details</td>
                            <td>
                                @if (!string.IsNullOrEmpty(log.CorrelationId))
                                {
                                    <code class="small text-secondary">@log.CorrelationId</code>
                                }
                                else
                                {
                                    <span class="text-muted small">None</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
