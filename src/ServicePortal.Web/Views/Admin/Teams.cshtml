@model List<ServicePortal.Domain.Entities.SupportTeam>
@{
    ViewData["Title"] = "Support Teams Management";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-diagram-3-fill text-success"></i> Support Teams</h2>
        <p class="text-muted small mb-0">Configure organizational support units, members, and ticket routing destinations</p>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createTeamModal">
        <i class="bi bi-plus-lg"></i> Create Support Team
    </button>
</div>

<div class="row g-4">
    @foreach (var team in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card portal-card h-100 border-0 shadow-sm">
                <div class="card-header card-header-clean bg-white d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-dark fs-5">@team.Name</span>
                    <span class="badge @(team.IsActive ? "bg-success" : "bg-secondary")">@(team.IsActive ? "Active" : "Inactive")</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small">@team.Description</p>
                    <div class="d-flex justify-content-between align-items-center py-2 border-top small">
                        <span class="text-muted">Assigned Members:</span>
                        <span class="fw-bold">@team.Members.Count Agents/Leads</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-top small">
                        <span class="text-muted">Routed Categories:</span>
                        <span class="fw-bold">@team.Categories.Count Categories</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal: Create Team -->
<div class="modal fade" id="createTeamModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateTeam" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Create Support Team</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Team Name</label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. Cloud Infrastructure" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea name="description" class="form-control" rows="3" placeholder="Scope of team responsibility..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Team</button>
                </div>
            </form>
        </div>
    </div>
</div>
